@prefix : <http://www.semanticweb.org/pet-management-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/pet-management-ontology#> .

<http://www.semanticweb.org/pet-management-ontology> rdf:type owl:Ontology ;
                                                      rdfs:comment "Pet management ontology v2 with extended hierarchy and property restrictions." .

#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/pet-management-ontology#hasOwner
:hasOwner rdf:type owl:ObjectProperty ;
          owl:inverseOf :ownsPet ;
          rdfs:domain :Pet ;
          rdfs:range :Owner .


###  http://www.semanticweb.org/pet-management-ontology#isTreatedBy
:isTreatedBy rdf:type owl:ObjectProperty ;
             owl:inverseOf :treatsPet ;
             rdfs:domain :Pet ;
             rdfs:range :Veterinarian .


###  http://www.semanticweb.org/pet-management-ontology#ownsPet
:ownsPet rdf:type owl:ObjectProperty .


###  http://www.semanticweb.org/pet-management-ontology#treatsPet
:treatsPet rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/pet-management-ontology#hasAge
:hasAge rdf:type owl:DatatypeProperty ,
                 owl:FunctionalProperty ;
        rdfs:domain :Pet ;
        rdfs:range xsd:integer .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/pet-management-ontology#Bird
:Bird rdf:type owl:Class ;
      rdfs:subClassOf :Pet .


###  http://www.semanticweb.org/pet-management-ontology#Cat
:Cat rdf:type owl:Class ;
     rdfs:subClassOf :Pet .


###  http://www.semanticweb.org/pet-management-ontology#Dog
:Dog rdf:type owl:Class ;
     rdfs:subClassOf :Pet .


###  http://www.semanticweb.org/pet-management-ontology#Owner
:Owner rdf:type owl:Class .


###  http://www.semanticweb.org/pet-management-ontology#Pet
:Pet rdf:type owl:Class .


###  http://www.semanticweb.org/pet-management-ontology#Treatment
:Treatment rdf:type owl:Class .


###  http://www.semanticweb.org/pet-management-ontology#Veterinarian
:Veterinarian rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://www.semanticweb.org/pet-management-ontology#Susu
:Susu rdf:type owl:NamedIndividual ,
               :Cat ;
      :hasAge 3 .


